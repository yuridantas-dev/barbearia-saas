# Neon PostgreSQL — copie a connection string COMPLETA do painel Neon (Dashboard → Connect)
# No Render: cole a MESMA URL aqui (postgresql://...). Não use texto de exemplo.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo para tokens JWT (troque em produção)
JWT_SECRET=sua-chave-secreta-longa-aqui

# Admin da plataforma SaaS (criado no db:migrate)
PLATFORM_ADMIN_EMAIL=admin@barbearia.app
PLATFORM_ADMIN_PASSWORD=admin123456
PLATFORM_ADMIN_NAME=Admin SaaS

# API
PORT=3001

# E-mail (Resend) — opcional; sem isso o código aparece no terminal da API
RESEND_API_KEY=
RESEND_FROM=Barbearia SaaS <noreply@seudominio.com>

# Front (Vercel) — URL da API no Render, COM /api no final
# Em produção também há .env.production (commitado) com a URL do Render.
VITE_API_URL=https://barbearia-api-tb5o.onrender.com/api